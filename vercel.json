{
    "version": 2,
    "framework": "vite",
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/vite",
        "config": {
          "distDir": "dist"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }
